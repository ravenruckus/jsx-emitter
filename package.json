{
  "name": "jsx-emitter",
  "version": "0.0.0",
  "description": "Standalone JSON-to-React generator. Compiles a structured JSON component representation into React source code.",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "clean": "rimraf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "keywords": [
    "react",
    "codegen",
    "json",
    "compiler",
    "jsx"
  ],
  "devDependencies": {
    "@types/babel__core": "^7.20.5",
    "@types/babel__generator": "^7.27.0",
    "@types/lodash": "^4.17.24",
    "@types/node": "^25.6.0",
    "@types/object-hash": "^3.0.6",
    "csstype": "^3.2.3",
    "rimraf": "^5.0.5",
    "typescript": "^5.3.2",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "@babel/core": "^7.29.0",
    "@babel/generator": "^7.29.1",
    "@babel/plugin-syntax-decorators": "^7.28.6",
    "@babel/plugin-syntax-typescript": "^7.28.6",
    "@babel/preset-typescript": "^7.28.5",
    "fp-ts": "^2.16.11",
    "json5": "^2.2.3",
    "lodash": "^4.18.1",
    "neotraverse": "^0.6.18",
    "object-hash": "^3.0.0"
  }
}
