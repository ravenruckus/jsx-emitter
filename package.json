{
  "name": "jsx-emitter",
  "version": "0.0.0",
  "description": "Standalone JSON-to-React generator. Compiles a structured JSON component representation into React source code.",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "clean": "rimraf dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "react",
    "codegen",
    "json",
    "compiler",
    "jsx"
  ],
  "devDependencies": {
    "@types/node": "^25.6.0",
    "rimraf": "^5.0.5",
    "typescript": "^5.3.2",
    "vitest": "^1.6.0"
  }
}
